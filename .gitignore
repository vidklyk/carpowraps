# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large frame assets (hosted on Cloudflare R2)
/public/frames/
/public/wrap_frames/
/public/frames_mobile/

# local dev tooling
.wrangler/

# Wrangler local state
.wrangler/
public/wrap_frames_mobile/
public/wrap_frames/
frames_ceramic/
